<section class="pdp">
  <div class="pdp__wrap">
    <div class="pdp__gallery">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          {{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,675,900' }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="pdp__info">
      <h1 class="pdp__title">{{ product.title }}</h1>

      <p class="pdp__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="pdp__price--sale">{{ product.price | money }}</span>
          <s class="pdp__price--compare">{{ product.compare_at_price | money }}</s>
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>

      {% form 'product', product %}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pdp__option">
              <label for="Option-{{ option.position }}">{{ option.name }}</label>
              <select id="Option-{{ option.position }}" name="options[{{ option.name | escape }}]">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <button type="submit" class="pdp__atc-wrap" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>

        {{ form.errors | default_errors }}
      {% endform %}

      <div class="pdp__description">{{ product.description }}</div>
    </div>
  </div>
</section>

{% stylesheet %}
.pdp__wrap {
  max-width: 1320px;
  margin: 0 auto;
  padding: 48px 32px;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 48px;
}

.pdp__gallery {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.pdp__gallery img {
  width: 100%;
  border-radius: 8px;
}

.pdp__title {
  margin: 0 0 12px;
}

.pdp__price {
  font-size: 1.25rem;
  margin: 0 0 24px;
}

.pdp__price--compare {
  opacity: 0.5;
  margin-left: 8px;
}

.pdp__option {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 16px;
}

.pdp__atc-wrap button,
.pdp__atc-wrap {
  width: 100%;
  padding: 14px 24px;
  border-radius: 999px;
  background: #4a2f1f;
  color: #fff;
  border: none;
  font-weight: 600;
  cursor: pointer;
}

.pdp__atc-wrap:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.pdp__description {
  margin-top: 32px;
  line-height: 1.6;
}

@media (max-width: 989px) {
  .pdp__wrap {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_product.name"
}
{% endschema %}
